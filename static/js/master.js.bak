// ═══════════════════════════════════════════════
// APEX SOVEREIGN V4 — Master Control
// Part 1 of 2 (Lines 1-210)
// ═══════════════════════════════════════════════

const API_BASE = window.location.origin;
let TOKEN = localStorage.getItem("apex_token") || "";
let USER_EMAIL = localStorage.getItem("apex_email") || "";
let DEVICES = [];
let WS = null;
let pendingConfirm = null;

const $ = id => document.getElementById(id);

// ─── AUTH ───────────────────────────────────────

function switchTab(name) {
  document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
  document.querySelectorAll(".form").forEach(f => f.classList.remove("active"));
  if (name === "login") {
    document.querySelectorAll(".tab")[0].classList.add("active");
    $("loginForm").classList.add("active");
  } else {
    document.querySelectorAll(".tab")[1].classList.add("active");
    $("registerForm").classList.add("active");
  }
}

async function doLogin() {
  const email = $("loginEmail").value.trim();
  const pass = $("loginPass").value;
  $("loginErr").textContent = "";
  if (!email || !pass) { $("loginErr").textContent = "ইমেইল ও পাসওয়ার্ড দিন"; return; }
  try {
    const body = new URLSearchParams({ username: email, password: pass });
    const res = await fetch(`${API_BASE}/api/auth/login`, { method: "POST", body });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Login failed");
    TOKEN = data.access_token;
    USER_EMAIL = email;
    localStorage.setItem("apex_token", TOKEN);
    localStorage.setItem("apex_email", USER_EMAIL);
    enterApp();
  } catch (e) { $("loginErr").textContent = "❌ " + e.message; }
}

async function doRegister() {
  const email = $("regEmail").value.trim();
  const name = $("regName").value.trim();
  const pass = $("regPass").value;
  const consent = $("regConsent").checked;
  $("regErr").textContent = "";
  if (!email || !pass) { $("regErr").textContent = "ইমেইল ও পাসওয়ার্ড দিন"; return; }
  if (pass.length < 6) { $("regErr").textContent = "পাসওয়ার্ড কমপক্ষে ৬ অক্ষর হতে হবে"; return; }
  if (!consent) { $("regErr").textContent = "❌ সম্মতি চেকবক্স আবশ্যক"; return; }
  try {
    const res = await fetch(`${API_BASE}/api/auth/register`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, name: name || email.split("@")[0], password: pass, consent_accepted: true })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Register failed");
    TOKEN = data.access_token;
    USER_EMAIL = email;
    localStorage.setItem("apex_token", TOKEN);
    localStorage.setItem("apex_email", USER_EMAIL);
    enterApp();
  } catch (e) { $("regErr").textContent = "❌ " + e.message; }
}

function doLogout() {
  if (!confirm("লগআউট করবেন?")) return;
  localStorage.removeItem("apex_token");
  localStorage.removeItem("apex_email");
  TOKEN = "";
  USER_EMAIL = "";
  if (WS) { WS.close(); WS = null; }
  $("mainScreen").classList.remove("active");
  $("loginScreen").classList.add("active");
}

function enterApp() {
  $("loginScreen").classList.remove("active");
  $("mainScreen").classList.add("active");
  $("userEmail").textContent = USER_EMAIL;
  $("settingsEmail").textContent = USER_EMAIL;
  $("settingsServer").textContent = API_BASE;
  loadDevices();
  connectWS();
}

// ─── NAV ────────────────────────────────────────

function showTab(name) {
  document.querySelectorAll(".nav-tab").forEach(t => t.classList.remove("active"));
  document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
  const idx = name === "devices" ? 1 : name === "add" ? 2 : 3;
  document.querySelector(`.nav-tab:nth-child(${idx})`).classList.add("active");
  $(`tab-${name}`).classList.add("active");
  if (name === "audit") updateAuditDeviceList();
}

// ─── API HELPER ─────────────────────────────────

async function api(path, opts = {}) {
  opts.headers = { ...(opts.headers || {}), "Authorization": "Bearer " + TOKEN };
  const res = await fetch(API_BASE + path, opts);
  if (res.status === 401) { doLogout(); throw new Error("Session expired"); }
  if (!res.ok) throw new Error(await res.text());
  return res.json();
}

// ─── DEVICES LOAD/RENDER ────────────────────────

async function loadDevices() {
  try {
    DEVICES = await api("/api/devices");
    renderDevices();
    $("settingsDeviceCount").textContent = `${DEVICES.length} / 10 devices`;
    updateAuditDeviceList();
  } catch (e) {
    $("devicesGrid").innerHTML = `<p class="empty err">Load failed: ${e.message}</p>`;
  }
}

function refreshDevices() {
  toast("রিফ্রেশ হচ্ছে...");
  loadDevices();
}

function renderDevices() {
  const grid = $("devicesGrid");
  if (!DEVICES || DEVICES.length === 0) {
    grid.innerHTML = `<div class="empty">
      <p style="font-size:48px;margin-bottom:12px">📱</p>
      <p>No devices yet</p>
      <p style="font-size:12px;margin-top:8px">Go to "Add Device" tab to pair a child device</p>
    </div>`;
    return;
  }
  grid.innerHTML = DEVICES.map(d => renderDeviceCard(d)).join("");
}

function renderDeviceCard(d) {
  const batteryColor = d.battery_level < 20 ? "#dc2626" : d.battery_level < 50 ? "#f59e0b" : "#22c55e";
  const storagePct = d.storage_total_mb ? Math.min(100, (d.storage_free_mb / d.storage_total_mb) * 100) : 0;
  const screenPct = d.daily_limit_minutes ? Math.min(100, (d.screen_time_minutes / d.daily_limit_minutes) * 100) : 0;

  return `
  <div class="device-card ${d.is_online ? 'online' : 'offline'}">
    <div class="device-header">
      <div>
        <div class="device-name"><span class="status-dot ${d.is_online ? 'online' : 'offline'}"></span>${escape(d.child_name || "Unknown")}</div>
        <div class="device-model">${escape(d.device_model || "Android")} • v${d.android_version || "?"}</div>
      </div>
      <button class="icon-btn" onclick="openDeviceDetail(${d.id})" title="Details">ℹ️</button>
    </div>
    <div class="device-stats">
      <div class="stat">
        <div class="stat-label">🔋 Battery</div>
        <div class="stat-value">${d.battery_level || 0}%</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${d.battery_level || 0}%;background:${batteryColor}"></div></div>
      </div>
      <div class="stat">
        <div class="stat-label">💾 Storage</div>
        <div class="stat-value">${d.storage_free_mb || 0} MB</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${storagePct}%;background:#3b82f6"></div></div>
      </div>
      <div class="stat">
        <div class="stat-label">⏱️ Screen</div>
        <div class="stat-value">${d.screen_time_minutes || 0} min</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${screenPct}%;background:#7c3aed"></div></div>
      </div>
      <div class="stat">
        <div class="stat-label">📍 Location</div>
        <div class="stat-value" style="font-size:11px">${d.last_lat ? d.last_lat.toFixed(3) + ', ' + d.last_lon.toFixed(3) : "—"}</div>
      </div>
    </div>
    <div class="device-actions">
      <button onclick="sendCommand(${d.id},'LOCK')">🔒 লক</button>
      <button onclick="sendCommand(${d.id},'RING')">🔔 রিং</button>
      <button onclick="sendCommand(${d.id},'LOCATE')">📍 লোকেশন</button>
      <button class="stream" onclick="openScreenStream(${d.id})">📺 দেখুন</button>
      <button onclick="openAuditFor(${d.id})">📋 লগ</button>
      <button class="danger" onclick="sendCommand(${d.id},'WIPE')">⚠️ মুছুন</button>
    </div>
  </div>`;
}

function escape(s) {
  return String(s || "").replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// ─── COMMANDS ───────────────────────────────────

async function sendCommand(deviceId, command) {
  const labels = {
    LOCK: "🔒 Lock device?",
    RING: "🔔 Ring device?",
    LOCATE: "📍 Locate device?",
    WIPE: "⚠️ WIPE ALL DATA? This cannot be undone!",
    SCREENSHOT: "📸 Capture screenshot?"
  };
  showConfirm(labels[command] || `Send ${command}?`, async () => {
    try {
      await api(`/api/commands/${deviceId}/${command}`, { method: "POST" });
      toast(`✅ ${command} queued`, "success");
    } catch (e) { toast("❌ " + e.message, "error"); }
  });
}

// ─── PAIRING ────────────────────────────────────

async function createPairing() {
  const name = $("newChildName").value.trim() || "New Child";
  $("qrContainer").innerHTML = '<p class="info">Generating QR...</p>';
  try {
    const data = await api(`/api/devices/create-pairing?child_name=${encodeURIComponent(name)}`, { method: "POST" });
    $("qrContainer").innerHTML = `
      <img src="${data.qr_url}" alt="QR">
      <div class="enroll-url">${data.enroll_url}</div>
      <p class="info" style="margin-top:12px">📱 Scan with child's phone</p>
      <a href="${data.enroll_url}" target="_blank" class="btn btn-small btn-primary" style="margin-top:8px;display:inline-block">Open Enroll Page</a>`;
    $("newChildName").value = "";
    loadDevices();
  } catch (e) { $("qrContainer").innerHTML = `<p class="err">${e.message}</p>`; }
}

// ─── DEVICE DETAIL MODAL ────────────────────────

function openDeviceDetail(deviceId) {
  const d = DEVICES.find(x => x.id === deviceId);
  if (!d) return;
  $("modalTitle").textContent = d.child_name || "Device";
  $("modalBody").innerHTML = `
    <div class="settings-item"><strong>Device UID</strong><p>${d.device_uid || "—"}</p></div>
    <div class="settings-item"><strong>Model</strong><p>${escape(d.device_model)} (Android ${d.android_version || "?"})</p></div>
    <div class="settings-item"><strong>Status</strong><p>${d.is_online ? "🟢 Online" : "🔴 Offline"}</p></div>
    <div class="settings-item"><strong>Paired At</strong><p>${d.paired_at ? new Date(d.paired_at).toLocaleString() : "—"}</p></div>
    <div class="settings-item"><strong>Last Heartbeat</strong><p>${d.last_heartbeat ? new Date(d.last_heartbeat).toLocaleString() : "—"}</p></div>
    <div class="settings-item"><strong>Battery</strong><p>${d.battery_level || 0}%</p></div>
    <div class="settings-item"><strong>Storage</strong><p>${d.storage_free_mb || 0} MB free / ${d.storage_total_mb || 0} MB total</p></div>
    <div class="settings-item"><strong>Screen Time</strong><p>${d.screen_time_minutes || 0} min / limit ${d.daily_limit_minutes || 0} min</p></div>
    <div class="settings-item"><strong>Location</strong><p>${d.last_lat ? d.last_lat.toFixed(6) + ", " + d.last_lon.toFixed(6) : "—"}</p></div>
    <div style="margin-top:16px">
      <button class="btn btn-info" onclick="openScreenStream(${d.id});closeModal();" style="width:100%;margin-bottom:8px">📺 Live Screen</button>
      <button class="btn btn-danger" onclick="sendCommand(${d.id},'WIPE');closeModal();" style="width:100%">⚠️ Wipe Device</button>
    </div>`;
  $("deviceModal").classList.add("active");
}

function closeModal() {
  $("deviceModal").classList.remove("active");
}

// ─── SETTINGS MODAL ─────────────────────────────

function showSettings() {
  $("settingsModal").classList.add("active");
}

function closeSettings() {
  $("settingsModal").classList.remove("active");
}

// ─── CONFIRM DIALOG ─────────────────────────────

function showConfirm(text, onYes) {
  $("confirmTitle").textContent = "Confirm";
  $("confirmText").textContent = text;
  $("confirmDialog").classList.add("active");
  pendingConfirm = onYes;
}

function confirmYes() {
  const fn = pendingConfirm;
  pendingConfirm = null;
  $("confirmDialog").classList.remove("active");
  if (fn) fn();
}

function cancelConfirm() {
  pendingConfirm = null;
  $("confirmDialog").classList.remove("active");
}

// ─── TOAST ──────────────────────────────────────

function toast(msg, type = "") {
  const el = $("toast");
  el.textContent = msg;
  el.className = "toast show " + type;
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => {
    el.classList.remove("show");
  }, 3000);
}

// ─── SCREEN STREAM ──────────────────────────────

function openScreenStream(deviceId) {
  const d = DEVICES.find(x => x.id === deviceId);
  if (!d) return;
  $("modalTitle").textContent = `📺 ${d.child_name || "Device"} — Live Screen`;
  $("modalBody").innerHTML = `
    <p class="info">Child device-এ "Start Screen Streaming" চাপতে হবে।</p>
    <div class="screen-view" id="screenView">
      <img id="screenImg" src="/api/devices/${deviceId}/frame?t=${Date.now()}"
           onerror="document.getElementById('screenView').innerHTML='<p class=info style=padding:40px;text-align:center>📵 No frame yet — child must start streaming</p>'"
           onload="this.style.display='block'" style="display:none">
    </div>
    <button class="btn btn-primary btn-large" onclick="refreshScreenFrame(${deviceId})" style="margin-top:12px">🔄 Refresh Frame</button>
    <p class="info" style="margin-top:8px;font-size:11px">Auto-refresh every 5 seconds while open</p>`;
  $("deviceModal").classList.add("active");

  // Auto refresh
  if (window._screenTimer) clearInterval(window._screenTimer);
  window._screenTimer = setInterval(() => refreshScreenFrame(deviceId), 5000);
}

function refreshScreenFrame(deviceId) {
  const img = $("screenImg");
  if (img) {
    img.src = `/api/devices/${deviceId}/frame?t=${Date.now()}`;
    img.style.display = "block";
  }
}

// ─── AUDIT ──────────────────────────────────────

function updateAuditDeviceList() {
  const sel = $("auditDevice");
  const current = sel.value;
  sel.innerHTML = '<option value="">Select a device...</option>' +
    DEVICES.filter(d => d.is_paired).map(d =>
      `<option value="${d.device_uid}">${escape(d.child_name)} (${d.device_model})</option>`
    ).join("");
  if (current) sel.value = current;
}

function openAuditFor(deviceId) {
  const d = DEVICES.find(x => x.id === deviceId);
  if (!d) return;
  showTab("audit");
  setTimeout(() => {
    $("auditDevice").value = d.device_uid;
    loadAudit();
  }, 100);
}

async function loadAudit() {
  const uid = $("auditDevice").value;
  if (!uid) { toast("Select a device first", "error"); return; }
  $("auditLog").innerHTML = '<p class="info">Loading...</p>';
  try {
    const log = await api(`/api/audit/${encodeURIComponent(uid)}`);
    if (!log || log.length === 0) {
      $("auditLog").innerHTML = '<p class="info">No logs yet</p>';
      return;
    }
    $("auditLog").innerHTML = log.map(e => `
      <div class="audit-item">
        <div class="audit-time">${e.server_ts ? new Date(e.server_ts).toLocaleString() : "—"}</div>
        <div class="audit-event">${escape(e.event || "")}</div>
        ${e.detail ? `<div class="audit-detail">${escape(e.detail)}</div>` : ""}
      </div>`).join("");
  } catch (e) {
    $("auditLog").innerHTML = `<p class="err">${e.message}</p>`;
  }
}

// ─── WEBSOCKET ──────────────────────────────────

function connectWS() {
  if (WS) WS.close();
  const proto = location.protocol === "https:" ? "wss:" : "ws:";
  WS = new WebSocket(`${proto}//${location.host}/ws/devices`);
  WS.onopen = () => console.log("[WS] connected");
  WS.onclose = () => { console.log("[WS] closed, retry in 5s"); setTimeout(connectWS, 5000); };
  WS.onerror = () => console.log("[WS] error");
  WS.onmessage = (e) => {
    try {
      DEVICES = JSON.parse(e.data);
      renderDevices();
      $("settingsDeviceCount").textContent = `${DEVICES.length} / 10 devices`;
    } catch (_) {}
  };
}

// ─── AUTO START ─────────────────────────────────

if (TOKEN) {
  enterApp();
}
